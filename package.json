{
  "name": "pilot",
  "version": "0.1.0",
  "bin": {
    "pilot": "bin/pilot.js"
  },
  "files": [
    "bin",
    "dist/client",
    "dist/server"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names server,client --prefix-colors blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/dev.ts",
    "dev:client": "vite",
    "build": "pnpm clean && pnpm build:client && pnpm build:server",
    "build:client": "vite build && node scripts/generate-service-worker.mjs && node scripts/compress-client-assets.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint bin src tests scripts vite.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.3.0",
    "fastify": "5.11.2",
    "highlight.js": "11.11.1",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "8.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
